QWidget { background: #f8fafc; color: #0f172a; font-family: "Segoe UI", "Noto Sans", sans-serif; font-size: 10pt; }
QLabel { background: transparent; background-color: transparent; }
QMainWindow, #AppShell, #WorkspaceStack { background: #f8fafc; }
#TopBar { background: #ffffff; border-bottom: 1px solid #cbd5e1; }
#BrandTitle { color: #0f172a; font-size: 15pt; font-weight: 700; }
#PrivacyNotice, #StatusText, #MetricDetail { color: #475569; }
#Sidebar { background: #eef2f7; border-right: 1px solid #cbd5e1; }
QToolButton#SidebarItem, QToolButton#SidebarToggle { background: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 7px; padding: 9px; text-align: left; }
QToolButton#SidebarItem:hover, QToolButton#SidebarToggle:hover { background: #e2e8f0; border-color: #0f766e; }
QToolButton#SidebarItem:focus, QToolButton#SidebarToggle:focus, QPushButton:focus, QLineEdit:focus, QPlainTextEdit:focus, QTableWidget:focus { border: 2px solid #0f766e; }
QLabel#PageTitle { color: #0f172a; font-size: 20pt; font-weight: 700; }
QLabel#FieldLabel { color: #0f172a; font-weight: 600; }
QFrame#MetricCard { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 9px; }
QLabel#MetricTitle { color: #475569; font-size: 9pt; }
QLabel#MetricValue { color: #0f172a; font-size: 19pt; font-weight: 700; }
QCheckBox { color: #1e293b; spacing: 8px; font-size: 13px; }
QCheckBox::indicator { width: 18px; height: 18px; border: 2px solid #64748b; border-radius: 4px; background-color: #ffffff; }
QCheckBox::indicator:hover { border-color: #0284c7; }
QCheckBox::indicator:checked { background-color: #0284c7; border-color: #0284c7; image: url("__CHECK_ICON__"); }
QLineEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTableWidget { background: #ffffff; color: #0f172a; border: 1px solid #94a3b8; border-radius: 5px; padding: 6px; selection-background-color: #0f766e; selection-color: #ffffff; }
QHeaderView::section { background: #e2e8f0; color: #0f172a; border: 1px solid #cbd5e1; padding: 7px; }
QTableWidget::item:alternate { background: #f1f5f9; }
QTableWidget { alternate-background-color: #f8fafc; }
QTableWidget::item { color: #0f172a; background: #ffffff; }
QTableWidget::item:alternate { color: #0f172a; background: #f8fafc; }
QTableWidget, QTableView { background: #ffffff; alternate-background-color: #f8fafc; color: #0f172a; gridline-color: #cbd5e1; }
QTableView::item, QTableWidget::item { color: #0f172a; background: #ffffff; }
QTableView::item:alternate, QTableWidget::item:alternate { color: #0f172a; background: #f8fafc; }
QTableWidget::item:selected, QTableWidget::item:selected:active,
QTableWidget::item:selected:!active { background: #0284c7; color: #ffffff; font-weight: 700; }
QTableWidget:focus { outline: none; }
QPushButton { background: #ffffff; color: #0f172a; border: 1px solid #94a3b8; border-radius: 6px; padding: 8px 13px; }
QPushButton:hover { background: #e2e8f0; border-color: #0f766e; }
QPushButton#PrimaryButton { background: #0f766e; color: #ffffff; border-color: #115e59; font-weight: 700; padding: 10px 18px; }
QPushButton#PrimaryButton:hover { background: #115e59; }
QMenuBar { background: #ffffff; color: #0f172a; border-bottom: 1px solid #cbd5e1; }
QMenuBar::item:selected { background: #e2e8f0; }
QMenu {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px;
    min-width: 230px;
}
QMenu::item {
    color: #0f172a;
    padding: 8px 32px 8px 14px;
    border-radius: 5px;
    font-size: 13px;
}
QMenu::item:selected { background-color: #e2e8f0; color: #0f172a; }
QMenu::separator { height: 1px; background: #cbd5e1; margin: 4px 8px; }
QStatusBar { background: #ffffff; color: #475569; border-top: 1px solid #cbd5e1; }
QToolTip { background-color: #ffffff; color: #0f172a; border: 1px solid #64748b; padding: 5px; border-radius: 4px; }

/* ========================================================================== */
/* MODERN MINIMALIST SCROLLBARS (Vertical & Horizontal)                        */
/* ========================================================================== */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 12px;
    margin: 2px 2px 2px 2px;
    border-radius: 6px;
}
QScrollBar::track:vertical { background: transparent; border-radius: 4px; }
QScrollBar::handle:vertical {
    background: #94a3b8;
    min-height: 32px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover { background: #64748b; }
QScrollBar::handle:vertical:pressed { background: #475569; }
QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    border: none;
    background: none;
    height: 0px;
    subcontrol-origin: margin;
}
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 12px;
    margin: 2px 2px 2px 2px;
    border-radius: 6px;
}
QScrollBar::track:horizontal { background: transparent; border-radius: 4px; }
QScrollBar::handle:horizontal {
    background: #94a3b8;
    min-width: 32px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover { background: #64748b; }
QScrollBar::handle:horizontal:pressed { background: #475569; }
QScrollBar::sub-line:horizontal, QScrollBar::add-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    subcontrol-origin: margin;
}
QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

QScrollArea { border: none; background-color: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar::corner { background: transparent; }
