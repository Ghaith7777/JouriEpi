QWidget { background: #121214; color: #f4f4f5; font-family: "Segoe UI", "Noto Sans", sans-serif; font-size: 10pt; }
QLabel { background: transparent; background-color: transparent; }
QMainWindow, #AppShell, #WorkspaceStack, QScrollArea { background: #121214; }
#TopBar { background: #1a1a1e; border-bottom: 1px solid #2e2e34; }
#BrandTitle { color: #f4f4f5; font-size: 15pt; font-weight: 700; }
#PrivacyNotice, #StatusText, #MetricDetail { color: #a1a1aa; }
#Sidebar { background: #1a1a1e; border-right: 1px solid #2e2e34; }
QToolButton#SidebarItem, QToolButton#SidebarToggle { background: #222226; color: #f4f4f5; border: 1px solid #2e2e34; border-radius: 7px; padding: 8px 9px 8px 14px; text-align: left; }
QToolButton#SidebarItem:hover, QToolButton#SidebarToggle:hover { background: #2b2b31; border-color: #52525b; }
QToolButton#SidebarItem:checked { background: #30303a; border-left: 3px solid #3b82f6; }
QToolButton#SidebarItem:focus, QToolButton#SidebarToggle:focus, QPushButton:focus, QLineEdit:focus, QPlainTextEdit:focus, QTableWidget:focus { border: 1px solid #3b82f6; }
QLabel#PageTitle { color: #f4f4f5; font-size: 20pt; font-weight: 700; }
QLabel#FieldLabel { color: #f4f4f5; font-weight: 600; }
QFrame#MetricCard { background: #1a1a1e; border: 1px solid #2e2e34; border-radius: 9px; }
QLabel#MetricTitle { color: #a1a1aa; font-size: 9pt; }
QLabel#MetricValue { color: #f4f4f5; font-size: 19pt; font-weight: 700; }
QCheckBox { color: #f4f4f5; spacing: 8px; font-size: 13px; }
QCheckBox::indicator { width: 18px; height: 18px; border: 2px solid #71717a; border-radius: 4px; background-color: #27272a; }
QCheckBox::indicator:hover { border-color: #38bdf8; }
QCheckBox::indicator:checked { background-color: #38bdf8; border-color: #38bdf8; image: url("__CHECK_ICON__"); }
QLineEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTableWidget { background: #222226; color: #f4f4f5; border: 1px solid #2e2e34; border-radius: 5px; padding: 6px; selection-background-color: #3b82f6; selection-color: #ffffff; }
QHeaderView::section { background: #1a1a1e; color: #f4f4f5; border: 1px solid #2e2e34; padding: 7px; }
QTableWidget, QTableView { background: #18181b; alternate-background-color: #222227; color: #f4f4f5; gridline-color: #27272a; }
QTableWidget::item, QTableView::item { color: #f4f4f5; background: #18181b; }
QTableWidget::item:alternate, QTableView::item:alternate { color: #f4f4f5; background: #222227; }
QTableWidget::item:selected, QTableWidget::item:selected:active,
QTableWidget::item:selected:!active { background: #0284c7; color: #ffffff; font-weight: 700; }
QTableWidget:focus { outline: none; }
QPushButton { background: #222226; color: #f4f4f5; border: 1px solid #2e2e34; border-radius: 6px; padding: 8px 13px; }
QPushButton:hover { background: #2b2b31; border-color: #52525b; }
QPushButton#PrimaryButton { background: #3b82f6; color: #ffffff; border-color: #3b82f6; font-weight: 700; padding: 10px 18px; }
QPushButton#PrimaryButton:hover { background: #2563eb; }
QMenuBar { background: #1a1a1e; color: #f4f4f5; border-bottom: 1px solid #2e2e34; }
QMenuBar::item:selected { background: #30303a; }
QMenu {
    background-color: #222226;
    color: #f4f4f5;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 6px;
    min-width: 230px;
}
QMenu::item {
    color: #f4f4f5;
    padding: 8px 32px 8px 14px;
    border-radius: 5px;
    font-size: 13px;
}
QMenu::item:selected { background-color: #30303a; color: #ffffff; }
QMenu::separator { height: 1px; background: #3f3f46; margin: 4px 8px; }
QStatusBar { background: #1a1a1e; color: #a1a1aa; border-top: 1px solid #2e2e34; }
QToolTip { background-color: #18181b; color: #e4e4e7; border: 1px solid #2e2e34; padding: 5px; border-radius: 4px; }

/* ========================================================================== */
/* MODERN MINIMALIST SCROLLBARS (Vertical & Horizontal)                        */
/* ========================================================================== */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 12px;
    margin: 2px 2px 2px 2px;
    border-radius: 6px;
}
QScrollBar::track:vertical { background: transparent; border-radius: 4px; }
QScrollBar::handle:vertical {
    background: #52525b;
    min-height: 32px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover { background: #38bdf8; }
QScrollBar::handle:vertical:pressed { background: #0284c7; }
QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    border: none;
    background: none;
    height: 0px;
    subcontrol-origin: margin;
}
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 12px;
    margin: 2px 2px 2px 2px;
    border-radius: 6px;
}
QScrollBar::track:horizontal { background: transparent; border-radius: 4px; }
QScrollBar::handle:horizontal {
    background: #3f3f46;
    min-width: 32px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover { background: #52525b; }
QScrollBar::handle:horizontal:pressed { background: #71717a; }
QScrollBar::sub-line:horizontal, QScrollBar::add-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    subcontrol-origin: margin;
}
QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

QScrollArea { border: none; background-color: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar::corner { background: transparent; }
